{
  "eval_id": 3,
  "eval_name": "vla-boundary-02-ai-vs-04-embodied",
  "prompt": "从 05_Papers/articles/pi0-7.md 提取 Vision-Language-Action (VLA) 模型的通用定义与训练目标。这个概念同时涉及通用多模态 AI 和具身智能，请判断应该放到哪个目录。",
  "assertions": [
    {
      "text": "VLA 通用概念按边界规则归入 02_AI",
      "check": "exists_file_under_path",
      "args": ["02_AI"],
      "target": "with_skill"
    },
    {
      "text": "with_skill 未将 VLA 通用定义放入 04_Embodied-AI",
      "check": "no_file_under_path",
      "args": ["04_Embodied-AI"],
      "target": "with_skill"
    },
    {
      "text": "输出解释了 02_AI 优先的边界判断理由",
      "check": "file_contains",
      "args": ["通用", "Embodied AI"],
      "target": "with_skill"
    },
    {
      "text": "VLA 概念被放入 01-04 的某个目录",
      "check": "exists_file_under_any_path",
      "args": ["01_Fundamentals", "02_AI", "03_Robotics", "04_Embodied-AI"],
      "target": "without_skill"
    },
    {
      "text": "生成处理摘要 summary.md",
      "check": "file_exists",
      "args": ["summary.md"],
      "target": "without_skill"
    }
  ]
}
